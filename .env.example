# ---- Core ------------------------------------------------------------------
# MongoDB Atlas in production (M10+ for continuous backup). Locally: run `npm run db:local`.
# MONGODB_URI=mongodb://127.0.0.1:27017/crr?replicaSet=rs0

# Production MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://hayzedboy20_db_user:3pKHwgKA2e90i8Bw@unizik-cpgs.nurhihy.mongodb.net/?appName=Unizik-CPGS

# Public base URL, used in emails, QR codes and verification links
APP_URL=http://localhost:3000
# Generate each with: openssl rand -base64 32
AUTH_SECRET=
VERIFY_HMAC_SECRET=
AUDIT_CHAIN_SECRET=
CRON_SECRET=
# Two-step verification for staff. Keep true in production.
REQUIRE_MFA=true

# ---- Files (Cloudinary, authenticated delivery) ------------------------------
# Leave empty to store scans on local disk in ./storage (development only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Second backup store for nightly copies (mounted university server path)
BACKUP_DIR=

# ---- Email (Brevo) -----------------------------------------------------------
# Leave empty to log emails to the console
BREVO_API_KEY=
MAIL_FROM=records@cpgs.unizik.edu.ng

# ---- Rate limiting (Upstash Redis) ------------------------------------------
# Leave empty to use an in-memory limiter (single instance only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Compliance -------------------------------------------------------------
NEXT_PUBLIC_DPO_EMAIL=dpo@unizik.edu.ng

# ---- Seeding ----------------------------------------------------------------
SEED_ADMIN_EMAIL=ict.cpgs@unizik.edu.ng
SEED_ADMIN_PASSWORD=
